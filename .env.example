# Cloud save: the Apps Script web app address (see docs/cloud-setup.md). Setting it here connects every device
# automatically; without it, connect devices from Mentor Hub → Sync & devices.
NEXT_PUBLIC_CLOUD_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MENTOR_EMAIL=
HANIFA_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
APP_URL=http://localhost:3000
